# Backend configuration (all optional; defaults shown)
CREDIT_ARTIFACT_DIR=artifacts
CREDIT_PREDICTIONS_DB=var/predictions.db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# CREDIT_DATA_PATH=data/raw/german.data
# Reject request bodies larger than this many bytes (HTTP 413)
CREDIT_MAX_BODY_BYTES=16384
# Prediction history: set to false to store nothing; rows older than N days are purged (0 = keep forever)
CREDIT_STORE_HISTORY=true
CREDIT_HISTORY_RETENTION_DAYS=30

# --- AI Financial Wellness Agent (backend only; never put these in frontend/.env) ---
# Put real keys in a git-ignored .env file or the shell environment.
# Which provider to use: gemini or anthropic (unset = whichever key is present, Anthropic first)
CREDIT_AGENT_PROVIDER=gemini
# Google Gemini API key (https://aistudio.google.com/apikey) and model
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# Anthropic API key (https://console.anthropic.com)
ANTHROPIC_API_KEY=
# CREDIT_AGENT_MODEL=claude-opus-5-5
# CREDIT_AGENT_TIMEOUT_SECONDS=90
# LLM-calling agent requests allowed per client IP per minute (0 = unlimited)
CREDIT_AGENT_RATE_LIMIT_PER_MINUTE=10
# Operator token for GET /predictions (lists every stored prediction). Leave empty to disable.
CREDIT_ADMIN_TOKEN=
